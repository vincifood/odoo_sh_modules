<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vinci_bulk_document_line_wizard_form" model="ir.ui.view">
        <field name="name">vinci.bulk.document.line.wizard.form</field>
        <field name="model">vinci.bulk.document.line.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Line Update">
                <group>
                    <field name="operation" invisible="1"/>
                    <field name="sale_order_id" invisible="1"/>
                    <field name="purchase_order_id" invisible="1"/>
                    <field name="route_id" invisible="operation != 'route'" required="operation == 'route'"
                           options="{'no_create': True}"/>
                    <field name="tax_id" invisible="operation != 'tax'" required="operation == 'tax'"
                           options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_apply" string="Tüm Ürünlere Uygula" type="object" class="btn-primary"/>
                    <button string="Vazgeç" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
