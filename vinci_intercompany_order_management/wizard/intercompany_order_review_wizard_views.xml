<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vinci_intercompany_order_review_wizard_form" model="ir.ui.view">
        <field name="name">vinci.intercompany.order.review.wizard.form</field>
        <field name="model">vinci.intercompany.order.review.wizard</field>
        <field name="arch" type="xml">
            <form string="Intercompany Document Review">
                <group>
                    <field name="sale_order_id"/>
                    <field name="operation" invisible="1"/>
                    <field name="cancellation_confirmation_stage" invisible="1"/>
                </group>
                <notebook invisible="cancellation_confirmation_stage != 'none'">
                    <page string="Revision Lines" invisible="operation != 'revision'">
                        <field name="revision_line_ids" nolabel="1">
                            <list editable="bottom" create="1" delete="1">
                                <field name="sale_order_line_id" column_invisible="1"/>
                                <field name="product_id" readonly="sale_order_line_id != False"/>
                                <field name="original_quantity" column_invisible="1"/>
                                <field name="new_quantity" column_invisible="1"/>
                                <field name="original_box_quantity" readonly="1"/>
                                <field name="new_box_quantity" string="New Boxes"/>
                                <field name="product_uom_id" readonly="sale_order_line_id != False"/>
                                <field name="product_packaging_id"
                                        readonly="sale_order_line_id != False"/>
                            </list>
                        </field>
                    </page>
                    <page string="Purchase Orders">
                        <field name="purchase_order_ids" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="partner_id"/>
                                <field name="state"/>
                                <field name="date_order"/>
                            </list>
                        </field>
                    </page>
                    <page string="Counterpart Sales Orders">
                        <field name="counterpart_sale_order_ids" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="partner_id"/>
                                <field name="state"/>
                                <field name="date_order"/>
                            </list>
                        </field>
                    </page>
                    <page string="Sales Invoices">
                        <field name="sale_invoice_ids" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="move_type"/>
                                <field name="state"/>
                                <field name="amount_total"/>
                            </list>
                        </field>
                    </page>
                    <page string="Purchase Bills">
                        <field name="purchase_invoice_ids" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="move_type"/>
                                <field name="state"/>
                                <field name="amount_total"/>
                            </list>
                        </field>
                    </page>
                    <page string="Stock Transfers">
                        <field name="picking_ids" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="picking_type_id"/>
                                <field name="state"/>
                                <field name="scheduled_date"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <group invisible="cancellation_confirmation_stage != 'first'">
                    <div class="alert alert-warning">WARNING: This operation affects the Central SO, Distribution PO, Distribution SO and their stock/accounting documents. First confirmation.</div>
                </group>
                <group invisible="cancellation_confirmation_stage != 'second'">
                    <div class="alert alert-danger">FINAL CONFIRMATION: The cancellation workflow can prepare physical returns and accounting reversals. Are you certain you want to proceed?</div>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Apply Revision"
                            class="btn-primary" invisible="cancellation_confirmation_stage != 'none'"/>
                    <button name="action_request_full_cancellation" type="object"
                            string="Cancel All Linked Documents" class="btn-secondary"
                            groups="sales_team.group_sale_manager"
                            invisible="cancellation_confirmation_stage != 'none'"/>
                    <button name="action_confirm_full_cancellation_first" type="object"
                            string="Yes, Continue to Final Confirmation" class="btn-secondary"
                            groups="sales_team.group_sale_manager"
                            invisible="cancellation_confirmation_stage != 'first'"/>
                    <button name="action_confirm_full_cancellation_final" type="object"
                            string="FINAL CONFIRMATION: Cancel Linked Documents" class="btn-danger"
                            groups="sales_team.group_sale_manager"
                            invisible="cancellation_confirmation_stage != 'second'"/>
                    <button name="action_back_to_revision" type="object"
                            string="Back to Revision" class="btn-secondary"
                            invisible="cancellation_confirmation_stage == 'none'"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
