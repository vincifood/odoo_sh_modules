<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vinci_intercompany_order_review_wizard_form" model="ir.ui.view">
        <field name="name">vinci.intercompany.order.review.wizard.form</field>
        <field name="model">vinci.intercompany.order.review.wizard</field>
        <field name="arch" type="xml">
            <form string="Intercompany Document Review">
                <group>
                    <field name="sale_order_id"/>
                    <field name="operation"/>
                </group>
                <notebook>
                    <page string="Revision Lines" invisible="operation != 'revision'">
                        <field name="revision_line_ids" nolabel="1">
                            <list editable="bottom" create="1" delete="0">
                                <field name="sale_order_line_id" column_invisible="1"/>
                                <field name="product_id" readonly="sale_order_line_id != False"/>
                                <field name="original_quantity" readonly="1"/>
                                <field name="new_quantity"/>
                                <field name="product_uom_id" readonly="sale_order_line_id != False"/>
                            </list>
                        </field>
                    </page>
                    <page string="Purchase Orders">
                        <field name="purchase_order_ids" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="partner_id"/>
                                <field name="state"/>
                                <field name="date_order"/>
                            </list>
                        </field>
                    </page>
                    <page string="Counterpart Sales Orders">
                        <field name="counterpart_sale_order_ids" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="partner_id"/>
                                <field name="state"/>
                                <field name="date_order"/>
                            </list>
                        </field>
                    </page>
                    <page string="Sales Invoices">
                        <field name="sale_invoice_ids" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="move_type"/>
                                <field name="state"/>
                                <field name="amount_total"/>
                            </list>
                        </field>
                    </page>
                    <page string="Purchase Bills">
                        <field name="purchase_invoice_ids" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="move_type"/>
                                <field name="state"/>
                                <field name="amount_total"/>
                            </list>
                        </field>
                    </page>
                    <page string="Stock Transfers">
                        <field name="picking_ids" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="picking_type_id"/>
                                <field name="state"/>
                                <field name="scheduled_date"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_confirm" type="object" string="Continue" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
